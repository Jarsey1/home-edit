NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional — only used as a nationwide fallback when the free Miami-Dade
# County public records have no match. The app works without it.
# RENTCAST_API_KEY=your-rentcast-api-key

# Optional — purchase prices below this amount trigger a confirmation warning.
# Defaults to 25000.
# NEXT_PUBLIC_PRICE_WARNING_THRESHOLD=25000

# Server-only. Required by /api/account/delete to permanently delete an
# authenticated user. Never expose this key in the browser bundle.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public launch links. If omitted, Settings marks them as not
# published and as a launch blocker.
# NEXT_PUBLIC_PRIVACY_URL=https://example.com/privacy
# NEXT_PUBLIC_TERMS_URL=https://example.com/terms
# NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
